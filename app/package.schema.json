{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/muniquant/commodity-evidence-package-0.1.schema.json",
  "title": "Commodity Evidence Package 0.1 draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "package_version": {
      "const": "0.1.0-draft"
    },
    "pipeline_version": {
      "const": "0.1.0"
    },
    "build_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "facility_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "commodity": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "facility_type",
          "country",
          "region",
          "commodity",
          "aliases"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "access_status": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "publisher",
          "source_type",
          "url",
          "access_status",
          "notes"
        ]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "original_url": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved_at": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "evidence_url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_id",
          "title",
          "original_url",
          "published_at",
          "retrieved_at",
          "media_type",
          "content_hash",
          "version",
          "evidence_url"
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "attribute": {
            "enum": [
              "capacity",
              "status"
            ]
          },
          "reported_value": {
            "type": "string"
          },
          "reported_unit": {
            "type": "string"
          },
          "normalized_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "normalized_unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_from": {
            "type": "string"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_reference": {
            "type": "string"
          },
          "quality_status": {
            "enum": [
              "PASS",
              "WARN"
            ]
          },
          "quality_messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parser_version": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string"
          },
          "resolution_status": {
            "const": "resolved"
          }
        },
        "required": [
          "id",
          "entity_id",
          "document_id",
          "attribute",
          "reported_value",
          "reported_unit",
          "normalized_value",
          "normalized_unit",
          "valid_from",
          "valid_to",
          "evidence_reference",
          "quality_status",
          "quality_messages",
          "parser_version",
          "recorded_at",
          "resolution_status"
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "company_id": {
            "type": "string"
          },
          "facility_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "percentage": {
            "type": [
              "number",
              "null"
            ]
          },
          "valid_from": {
            "type": "string"
          },
          "valid_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "document_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "company_id",
          "facility_id",
          "role",
          "percentage",
          "valid_from",
          "valid_to",
          "document_id"
        ]
      }
    },
    "market_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "instrument": {
            "type": "string"
          },
          "exchange": {
            "type": "string"
          },
          "market": {
            "type": "string"
          },
          "contract_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "commodity": {
            "type": "string"
          },
          "grade": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": "string"
          },
          "price_type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "effective_at": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume": {
            "type": [
              "integer",
              "null"
            ]
          },
          "open_interest": {
            "type": [
              "integer",
              "null"
            ]
          },
          "data_status": {
            "type": "string"
          },
          "document_id": {
            "type": "string"
          },
          "evidence_reference": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "instrument",
          "exchange",
          "market",
          "contract_code",
          "prompt_date",
          "commodity",
          "grade",
          "region",
          "price_type",
          "value",
          "currency",
          "unit",
          "effective_at",
          "published_at",
          "volume",
          "open_interest",
          "data_status",
          "document_id",
          "evidence_reference"
        ]
      }
    }
  },
  "required": [
    "package_version",
    "pipeline_version",
    "build_hash",
    "entities",
    "sources",
    "documents",
    "observations",
    "relationships",
    "market_observations"
  ]
}
