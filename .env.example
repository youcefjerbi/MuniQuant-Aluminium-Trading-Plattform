# Generate independent URL-safe secrets, e.g. python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-generated-hex-secret
WRITE_TOKEN=replace-with-another-generated-secret
WRITE_ACTOR=workspace-curator

# Optional separately attributable writes: JSON map of generated credentials to actor names.
WRITE_IDENTITIES_JSON=
# Enable authenticated API reads for shared/private deployment.
REQUIRE_READ_AUTH=false
READ_TOKEN=

# The Data Core this Workspace uses. CORE_URL is how this server reaches it; CORE_PUBLIC_URL is the
# address people open in their browser. CORE_TOKEN is the Workspace's credential for the Core: an
# entry of the Core's WRITE_IDENTITIES_JSON (or its WRITE_TOKEN). It is needed to propose candidate
# facts, and for reads when the Core sets REQUIRE_READ_AUTH=true.
CORE_URL=http://host.docker.internal:8000
CORE_PUBLIC_URL=http://127.0.0.1:8000
CORE_TOKEN=replace-with-a-third-generated-secret

# Only for compose.together.yaml, which also runs the Data Core from CORE_HOME (default ../muniquant-data-core).
CORE_POSTGRES_PASSWORD=replace-with-a-fourth-generated-secret
CORE_WRITE_TOKEN=replace-with-a-fifth-generated-secret

# Licensed Permutable AI key (lead-only event feed). Only the variable name is stored by the Workspace.
PERMUTABLE_API_KEY=
PERMUTABLE_TICKERS=ALI_COM

# Optional chatbot AI summaries. Local source-linked answers work without these.
# Enabling this permits selected excerpts/questions to be sent to OpenAI.
CHAT_AI_ENABLED=false
OPENAI_API_KEY=
CHAT_MODEL=
