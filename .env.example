# Generate independent URL-safe secrets, e.g. python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-generated-hex-secret
WRITE_TOKEN=replace-with-another-generated-secret
WRITE_ACTOR=pilot-curator

# Optional separately attributable writes: JSON map of generated credentials to actor names.
WRITE_IDENTITIES_JSON=
# Enable authenticated API reads for shared/private deployment.
REQUIRE_READ_AUTH=false
READ_TOKEN=

# Licensed Permutable AI key (lead-only event feed). Only the variable name is stored by the platform.
PERMUTABLE_API_KEY=
PERMUTABLE_TICKERS=ALI_COM

# Optional chatbot AI summaries. Local source-linked answers work without these.
# Enabling this permits selected excerpts/questions to be sent to OpenAI.
CHAT_AI_ENABLED=false
OPENAI_API_KEY=
CHAT_MODEL=

# Optional evidence-only TradingAgents proposals (paper account only).
# Install the pinned .[trading-agents] extra; see docs/TRADING_AGENTS.md.
TRADING_AGENTS_ENABLED=false
CORE_API_URL=
CORE_API_TOKEN=
TRADING_AGENTS_PROVIDER=openai
TRADING_AGENTS_QUICK_MODEL=
TRADING_AGENTS_DEEP_MODEL=
TRADING_AGENTS_OLLAMA_URL=http://localhost:11434/v1
